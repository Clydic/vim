"============Plugin==========
set rtp+=~/.vim/bundle/Vundle.vim
source ~/.vim/config/plugin.vim
filetype plugin indent on    " required


"===========Mapping==========

source ~/.vim/config/keymaps.vim 


"===========Config==========
source ~/.vim/config/options.vim



